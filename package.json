{
  "name": "anarchy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Anarchy: a Risk-style game of great-power politics for IR nerds.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "map": "node scripts/build-map.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-geo": "^3.1.1",
    "polygon-clipping": "^0.15.7",
    "topojson-client": "^3.1.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1",
    "world-atlas": "^2.0.2"
  }
}
